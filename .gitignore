# Python cache
__pycache__/
*.py[cod]

# Virtual environment
venv/

# YOLO outputs
runs/

# Model weights
# Ignore all PyTorch models
*.pt

# But include the deployment model
!models/detection/best.pt

# Dataset
datasets/

# Logs
logs/

# Output files
# Ignore generated files inside outputs
outputs/**

# Keep the folder structure
!outputs/
!outputs/csv/
!outputs/detections/
!outputs/json/
!outputs/plots/
!outputs/reports/
!outputs/tracking/
!outputs/videos/

# Keep placeholder files
!outputs/**/.gitkeep

# VS Code
.vscode/